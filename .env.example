NODE_ENV=development
API_PORT=3000
# Required in production: a persistent SQLite file (the API refuses to start without it).
DATABASE_PATH=./database/taptalk.db
# Comma-separated browser origins allowed to make state-changing requests (CSRF origin check).
# Leave empty in development: the Origin must then match the Host the browser used, which works
# for localhost and LAN addresses through the Vite proxy. Set it in production, or whenever a
# proxy rewrites the Host header, for example WEB_ORIGIN=https://taptalk.example
WEB_ORIGIN=
# Behind a reverse proxy: "true" or the proxy addresses (comma-separated, CIDR allowed). Otherwise all
# users share the proxy's address and its login rate limit.
TRUST_PROXY=false
# Login and registration attempts per client address per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
