NODE_ENV=development
# Fastify bind address. Use 0.0.0.0 in a container; keep loopback for local-only processes.
API_HOST=0.0.0.0
API_PORT=3000
# Required in production: an absolute persistent SQLite file (the API refuses to start otherwise).
DATABASE_PATH=./database/taptalk.db
# Development reflects any browser Origin and allows credentialed local cross-origin requests.
# This is intentionally permissive for local tooling; production ignores it and uses WEB_ORIGIN.
# Comma-separated browser origins allowed to make state-changing requests outside development.
# Required in production; set the exact HTTPS origin, for example https://taptalk.example.
WEB_ORIGIN=
# Behind Caddy: true trusts the single reverse proxy. Use an IP/CIDR list when the proxy chain differs.
# Otherwise all users share the proxy's address and its login rate limit.
TRUST_PROXY=false
# Login and registration attempts per client address per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
# Structured Fastify/Pino level. Production defaults to info when omitted.
LOG_LEVEL=info
# Maximum time allowed for in-flight requests during SIGTERM/SIGINT shutdown.
SHUTDOWN_TIMEOUT_MS=10000
