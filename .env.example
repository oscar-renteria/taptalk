NODE_ENV=development
API_PORT=3000
# Required in production: a persistent SQLite file (the API refuses to start without it).
DATABASE_PATH=./database/taptalk.db
# Development reflects any browser Origin and allows credentialed local cross-origin requests.
# This is intentionally permissive for local tooling; production ignores it and uses WEB_ORIGIN.
# Comma-separated browser origins allowed to make state-changing requests outside development.
# Leave empty when the API and browser share a host; set it in production, for example
# WEB_ORIGIN=https://taptalk.example
WEB_ORIGIN=
# Behind a reverse proxy: "true" or the proxy addresses (comma-separated, CIDR allowed). Otherwise all
# users share the proxy's address and its login rate limit.
TRUST_PROXY=false
# Login and registration attempts per client address per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
